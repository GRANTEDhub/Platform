# ─── Supabase ────────────────────────────────────────────────────────────────
# Project URL + keys from: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Anthropic (grant intelligence engine) ───────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key

# ─── Grants.gov / Simpler.grants.gov ingest ──────────────────────────────────
# API key from: https://simpler.grants.gov/developer
SIMPLER_GOV_API_KEY=
# Shared secret for the scheduled ingest route. Vercel Cron sends it as a
# Bearer token; set the same value here and in the Vercel project.
CRON_SECRET=

# ─── Org / geographic enrichment (all server-only) ───────────────────────────
# These power client-profile enrichment + prospect discovery. Each source is
# fail-safe: a missing key degrades that source to empty, it never breaks a save.
# All four are set in Vercel; documented here so a fresh deploy knows they're
# expected (values live in the Vercel project, never in the repo).
# Census geocoder + ACS demographics (lib/geo/census.ts, lib/grants/directories.ts).
CENSUS_API_KEY=
# SAM.gov Entity API — registration/UEI lookup (lib/sam/client.ts).
SAM_API_KEY=
# Brave Web Search — org discovery (lib/grants/brave.ts).
BRAVE_SEARCH_API_KEY=
# College Scorecard / IPEDS — higher-ed prospect enumeration (lib/grants/directories.ts).
COLLEGE_SCORECARD_API_KEY=
# NOTE: IRS 990 financials (ProPublica) and USASpending need NO key.
# Google Places API (New) — address autocomplete on the client/prospect form.
# PUBLIC by design (NEXT_PUBLIC_ = shipped to the browser): the key is restricted in
# Google Cloud to the app's own domain (HTTP referrer) + the two APIs it needs
# (Places API New, Maps JavaScript API), which is what protects it. It MUST be called
# from the browser -- a server-side call sends no Referer and is rejected. Absent or
# referrer-rejected (e.g. on a *.vercel.app preview) the form silently falls back to
# plain typed address inputs.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─── Stripe (invoicing) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email / alert sends (Resend) ─────────────────────────────────────────────
# Real sends fire ONLY when VERCEL_ENV=production AND this flag is "true" AND the
# key is present (see lib/email/guard.ts). Leave the flag unset/false anywhere a
# real client must not be emailed -- preview and prod share one database.
EMAIL_SENDING_ENABLED=false
# Resend API key (named to match the Vercel env var).
RESEND_PLATFORM_API=
# Sends from the verified Resend domain; replies routed to a monitored inbox.
EMAIL_FROM=alerts@send.grantedco.com
EMAIL_REPLY_TO=support@grantedco.com

# ─── App ──────────────────────────────────────────────────────────────────────
# Used to build auth redirect URLs. Set to your deployed origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Admin / user management ──────────────────────────────────────────────────
# Server-only. Comma-separated emails allowed to reach the in-app user-management
# panel (/settings/users) and create logins. A subset of admins, not all admins.
USER_ADMIN_ALLOWLIST=shannon@grantedco.com,samantha@grantedco.com

# ─── Pursuit / IntellEngine client access ─────────────────────────────────────
# Kill switch for the client-facing Pursuit surfaces (see lib/pursuit/access.ts and
# docs/matching-pursuit-model.md §7). The scope editor never persists and the compliance
# step discards uploads while turning the row green, so clients must not reach these
# screens until both are fixed. OFF unless the value is exactly "true".
# Staff are unaffected either way -- they drive the same wizard from the console.
PURSUIT_CLIENT_ACCESS_ENABLED=false
# Soft-launch teaser, INDEPENDENT of the access flag above (intellEngineComingSoon()). When true,
# the client-facing IntellEngine surfaces (nav tab, dashboard tile, pursue-chooser option) render
# VISIBLE but unclickable with a "COMING SOON" label instead of being omitted. Changes nothing about
# what a client can reach (routes still 404, API still refuses). Access wins if both are on. Staff
# never see the teaser. OFF unless exactly "true". Launch: this "true" + access above off.
INTELLENGINE_CLIENT_COMING_SOON=false

# ─── Allowable-uses list: client visibility ───────────────────────────────────
# Server-only. Whether the quote-verified "Allowable uses of funds" section renders on the
# CLIENT portal grant detail (lib/grants/allowable-uses.ts, migration 0072). Staff see it
# unconditionally on the console card — the staff-only first week exists so we read the real
# drop rate before a client does. OFF unless the value is exactly "true".
# The generation sweep runs either way; this gates presentation only.
ALLOWABLE_USES_CLIENT_VISIBLE=false
